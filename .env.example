# =====================================================
# Nigerian Credit Risk Engine - Environment Variables
# =====================================================
#
# SECURITY WARNING: Never commit the actual .env file!
# Copy this file to .env and fill in secure values.
#
# Generate secure keys with: openssl rand -hex 32
# =====================================================

# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Options: development, staging, production
API_ENV=development

# ============================================
# CRITICAL SECURITY SETTINGS
# ============================================
# REQUIRED IN PRODUCTION: Generate with: openssl rand -hex 32
# Must be at least 32 characters
SECRET_KEY=REPLACE_ME_WITH_SECURE_64_CHARACTER_KEY_GENERATED_BY_OPENSSL_RAND_HEX_32

# CORS - Allowed Origins (comma-separated)
# PRODUCTION: Use your actual domain(s), NEVER use localhost or *
# Example: https://app.creditrisk.ng,https://dashboard.creditrisk.ng
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=credit_risk_db
DB_USER=postgres
# REQUIRED IN PRODUCTION: Use strong password (16+ characters)
# Generate with: openssl rand -base64 24
DB_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD_16_PLUS_CHARACTERS

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PREDICTION=100/hour
RATE_LIMIT_GENERAL=1000/hour

# Redis for rate limiting (production)
# Development: memory://
# Production: redis://:password@host:6379/0
RATE_LIMIT_STORAGE_URL=memory://

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
# Sentry DSN for error tracking (get from sentry.io)
SENTRY_DSN=

# Sentry configuration
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=60

# ============================================
# LOGGING CONFIGURATION
# ============================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE_PATH=logs/app.log

# ============================================
# MLFLOW CONFIGURATION
# ============================================
MLFLOW_TRACKING_URI=http://localhost:5000

# ============================================
# MODEL CONFIGURATION
# ============================================
MODEL_NAME=xgboost

# ============================================
# NIGERIAN BANKING INTEGRATIONS
# ============================================
# NIBSS BVN Verification API
NIBSS_API_KEY=
NIBSS_API_URL=https://api.nibss-plc.com.ng
NIBSS_SANDBOX_MODE=true

# Twilio (for WhatsApp integration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+2348012345678

# ============================================
# CLOUD SERVICES (if using AWS)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Secrets Manager (for production)
AWS_SECRETS_ENABLED=false
AWS_SECRETS_NAME=credit-risk-engine/production

# ============================================
# REDIS CONFIGURATION (optional)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ============================================
# KAFKA CONFIGURATION (optional)
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREDICTIONS=credit-risk-predictions
KAFKA_TOPIC_ALERTS=credit-risk-alerts

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_BLOCKCHAIN=true
ENABLE_FRAUD_DETECTION=true
ENABLE_CBN_COMPLIANCE=true
ENABLE_REAL_TIME_STREAMING=false

# ============================================
# PRODUCTION CHECKLIST
# ============================================
# Before deploying to production, ensure:
# [ ] SECRET_KEY is set to a secure 64+ character key
# [ ] DB_PASSWORD is set to a strong 16+ character password
# [ ] ALLOWED_ORIGINS contains only your production domains
# [ ] API_ENV is set to "production"
# [ ] SENTRY_DSN is configured for error tracking
# [ ] All default passwords have been changed
# [ ] Redis is configured for rate limiting
# [ ] SSL/TLS certificates are installed
# [ ] Firewall rules are configured
# [ ] Database backups are enabled
# [ ] Monitoring alerts are configured
